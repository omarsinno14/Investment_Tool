generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RiskTolerance {
  EXTREMELY_LOW
  LOW
  MEDIUM
  MEDIUM_HIGH
  HIGH
  EXTREMELY_HIGH
}

enum InterestType {
  ASSET_CLASS
  STRATEGY
  REIT
  COUNTRY
  CITY
  SUBTOPIC
  CUSTOM
}

enum UserRole {
  USER
  ADMIN
}

enum AdminSignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ActionState {
  NONE
  SAVED
  VERY_INTERESTED
  INVESTED
}

enum NotificationType {
  MESSAGE
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  FORUM_REACTION
  FORUM_COMMENT
  OPPORTUNITY_MATCH
  OPPORTUNITY_TRENDING
  JOURNAL_INVITE
  JOURNAL_INVITE_ACCEPTED
  REPORT_RECEIVED
  NEWS_BREAKING
  FORUM_MENTION
  HUB_MENTION
}

enum HubPostType {
  DISCUSSION
  OPPORTUNITY_IMPORT
  NEWS_IMPORT
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TagSource {
  FORUM
  OPPORTUNITY
}

enum ReportTargetType {
  USER
  FORUM_POST
  OPPORTUNITY
  HUB_POST
  HUB_COMMENT
  MESSAGE
  NEWS
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DealStatus {
  DRAFT
  OPEN
  CLOSING_SOON
  FUNDED
  CLOSED
}

enum VerificationDocType {
  PASSPORT
  DRIVERS_LICENSE
  NATIONAL_ID
  PROOF_OF_ADDRESS
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AdPlacement {
  FEED
  OPPORTUNITIES
  HEADLINES
  SIDEBAR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  deactivatedAt DateTime?
  bannedAt      DateTime?
  banReason     String?
  restrictedAt  DateTime?
  restrictReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          UserRole  @default(USER)

  profile                    Profile?
  interests                  Interest[]
  actions                    OpportunityAction[]
  moneyManagement            MoneyManagement?
  postedOpportunities        Opportunity[]
  messagesSent               Message[]                 @relation("MessageFromUser")
  messagesReceived           Message[]                 @relation("MessageToUser")
  conversationParticipants   ConversationParticipant[]
  forumPosts                 ForumPost[]
  forumComments              ForumComment[]
  forumReactions             ForumReaction[]
  forumSaves                 ForumSave[]
  forumReposts               ForumRepost[]
  following                  Follow[]                  @relation("Follower")
  followers                  Follow[]                  @relation("Following")
  followRequestsSent         FollowRequest[]           @relation("FollowRequestSender")
  followRequestsReceived     FollowRequest[]           @relation("FollowRequestReceiver")
  notifications              Notification[]
  tagFollows                 TagFollow[]
  journalEntries             JournalEntry[]            @relation("JournalOwner")
  journalCollaborations      JournalCollaborator[]
  journalInvitesSent         JournalInvite[]           @relation("JournalInviteSender")
  journalInvitesReceived     JournalInvite[]           @relation("JournalInviteReceiver")
  reportsSent                Report[]                  @relation("ReportReporter")
  blocksInitiated            Block[]                   @relation("Blocker")
  blocksReceived             Block[]                   @relation("Blocked")
  hubsOwned                  Hub[]                     @relation("HubOwner")
  hubMemberships             HubMembership[]
  hubPosts                   HubPost[]
  hubComments                HubComment[]
  hubReactions               HubReaction[]
  contentMentions            ContentMention[]          @relation("MentionedUser")
  decidedAdminSignupRequests AdminSignupRequest[]      @relation("AdminRequestDecider")

  // ✅ Added missing back-relations (named to match the view models)
  opportunityViews OpportunityView[] @relation("OpportunityView_viewer")
  forumViews       ForumView[]       @relation("ForumView_viewer")
  pushTokens       PushToken[]

  verificationRequests   VerificationRequest[] @relation("VerificationSubject")
  reviewedVerifications  VerificationRequest[] @relation("VerificationReviewer")
  appSessions            AppSession[]
  supportTickets         SupportTicket[]
  emailVerificationTokens EmailVerificationToken[]
  reviewedReports        Report[]              @relation("ReportReviewer")
  adsCreated             Advertisement[]       @relation("AdCreator")
  auditLogs              AuditLog[]            @relation("AuditLogActor")
  opportunityComments    OpportunityComment[]
  portfolioAssets        PortfolioAsset[]
  savedSearches          SavedSearch[]
  earnedBadges           UserBadge[]

  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                        String?
  username                    String?       @unique
  usernameLower               String?       @unique
  phone                       String?       @unique
  imageUrl                    String?
  coverPhotoUrl               String?
  websiteUrl                  String?
  cvUrl                       String?
  bio                         String?
  occupation                  String?
  currency                    String?
  age                         Int?
  dateOfBirth                 DateTime?
  country                     String?
  city                        String?
  familySituation             String?
  netWorth                    Float?
  riskTolerance               RiskTolerance @default(MEDIUM)
  investAmount                Float?
  layoutPreference            String?
  emailVerified               Boolean       @default(false)
  phoneVerified               Boolean       @default(false)
  identityVerified            Boolean       @default(false)
  expertiseTags               String[]      @default([])
  verifiedExpertiseTags       String[]      @default([])
  hideAgeFromNonFollowers     Boolean       @default(false)
  hideContactFromNonFollowers Boolean       @default(false)
  hidePhotoFromNonFollowers   Boolean       @default(false)
  hidePostsFromNonFollowers   Boolean       @default(false)
  hideFollowerCount           Boolean       @default(false)
  requiresFollowApproval      Boolean       @default(false)
  notifyMessages              Boolean       @default(true)
  notifyFollows               Boolean       @default(true)
  notifyOpportunities         Boolean       @default(true)
  notifyForums                Boolean       @default(true)
  notifyJournal               Boolean       @default(true)
  reputation                  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Interest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      InterestType
  value     String
  parent    String?
  createdAt DateTime     @default(now())

  @@unique([userId, type, value])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FollowRequest {
  id          String              @id @default(cuid())
  followerId  String
  followingId String
  status      FollowRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  follower  User @relation("FollowRequestSender", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowRequestReceiver", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Opportunity {
  id                        String    @id @default(cuid())
  title                     String
  url                       String?   @unique
  source                    String?
  summary                   String?
  imageUrl                  String?
  imageUrls                 String[]  @default([])
  details                   String?
  askAmount                 Float?
  askCurrency               String?   @default("USD")
  benefits                  String?
  expectedRoiPercent        Float?
  expectedRoiDurationMonths Int?
  contactEmail              String?
  contactPhone              String?
  contactUsername           String?
  locationName              String?
  locationMapUrl            String?
  tags                      String[]  @default([])
  countryTags               String[]  @default([])
  cityTags                  String[]  @default([])
  assetTags                 String[]  @default([])
  strategyTags              String[]  @default([])
  keywordTags               String[]  @default([])
  messages                  Message[]
  createdByUserId           String?
  createdByUser             User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedAt               DateTime?
  fetchedAt                 DateTime  @default(now())
  archivedAt                DateTime?
  boostedAt                 DateTime?
  boostedUntil              DateTime?
  boostedBudget             Float?
  boostedCurrency           String?

  hubPosts   HubPost[] @relation("HubPostOpportunity")
  categories String[]  @default([])
  keywords   String[]  @default([])

  // Structured deal fields (Phase 4)
  dealType           String?
  companyName        String?
  minInvestment      Float?
  riskLevel          RiskTolerance?
  dealStatus         DealStatus         @default(OPEN)
  dealVerification   VerificationStatus @default(PENDING)
  closingDate        DateTime?
  dealScore          Float?
  documentUrls       String[]           @default([])

  actions  OpportunityAction[]
  views    OpportunityView[]
  comments OpportunityComment[]

  @@index([fetchedAt])
  @@index([createdByUserId, fetchedAt])
}

model OpportunityComment {
  id            String              @id @default(cuid())
  opportunityId String
  opportunity   Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        OpportunityComment? @relation("OppCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       OpportunityComment[] @relation("OppCommentReplies")
  body          String
  archivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([opportunityId])
  @@index([userId])
  @@index([parentId])
}

enum AssetType {
  CASH
  STOCKS
  ETF
  CRYPTO
  PRIVATE_EQUITY
  REAL_ESTATE
  VEHICLE
  WATCH
  ART
  BUSINESS
  DEBT
  OTHER
}

model PortfolioAsset {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  assetType            AssetType @default(OTHER)
  currency             String    @default("USD")
  currentValue         Float     @default(0)
  costBasis            Float?
  quantity             Float?
  isLiability          Boolean   @default(false)
  passiveIncomeMonthly Float?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

model SavedSearch {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  filters       Json
  alertsEnabled Boolean   @default(false)
  lastAlertedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey  String
  awardedAt DateTime @default(now())

  @@unique([userId, badgeKey])
  @@index([userId])
}

model AdminSignupRequest {
  id              String                   @id @default(cuid())
  email           String                   @unique
  username        String
  passwordHash    String
  status          AdminSignupRequestStatus @default(PENDING)
  createdAt       DateTime                 @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  decidedByUser   User?                    @relation("AdminRequestDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model OpportunityView {
  id            String   @id @default(cuid())
  opportunityId String
  viewerId      String?
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  // ✅ Named relation + back relation on User
  viewer      User?       @relation("OpportunityView_viewer", fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([opportunityId, createdAt])
  @@index([viewerId])
}

model ForumPost {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String
  imageUrl   String?
  tags       String[]  @default([])
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  comments  ForumComment[]
  reactions ForumReaction[]
  saves     ForumSave[]
  reposts   ForumRepost[]
  views     ForumView[]
  mentions  ContentMention[]

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Hub {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  imageUrl      String?
  coverImageUrl String?
  isPrivate     Boolean  @default(false)
  ownerUserId   String
  inviteToken   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       User            @relation("HubOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberships HubMembership[]
  posts       HubPost[]
  comments    HubComment[]
  reactions   HubReaction[]

  @@unique([name])
  @@index([name])
  @@index([ownerUserId])
}

model HubMembership {
  id       String   @id @default(cuid())
  hubId    String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  hub  Hub  @relation(fields: [hubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hubId, userId])
  @@index([userId, joinedAt])
}

model HubPost {
  id            String      @id @default(cuid())
  hubId         String
  authorUserId  String
  title         String
  body          String
  type          HubPostType @default(DISCUSSION)
  opportunityId String?
  newsHeadline  String?
  newsUrl       String?
  newsSource    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  editedAt      DateTime?
  deletedAt     DateTime?

  hub         Hub          @relation(fields: [hubId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation("HubPostOpportunity", fields: [opportunityId], references: [id], onDelete: SetNull)

  mentions  ContentMention[]
  comments  HubComment[]
  reactions HubReaction[]

  @@index([hubId, createdAt])
  @@index([authorUserId, createdAt])
}

model HubComment {
  id        String   @id @default(cuid())
  hubId     String
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hub  Hub     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  post HubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hubId, createdAt])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model HubReaction {
  id        String   @id @default(cuid())
  hubId     String
  postId    String
  userId    String
  type      String
  createdAt DateTime @default(now())

  hub  Hub     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  post HubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([hubId, createdAt])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model ContentMention {
  id              String   @id @default(cuid())
  forumPostId     String?
  hubPostId       String?
  mentionedUserId String
  createdAt       DateTime @default(now())

  forumPost     ForumPost? @relation(fields: [forumPostId], references: [id], onDelete: Cascade)
  hubPost       HubPost?   @relation(fields: [hubPostId], references: [id], onDelete: Cascade)
  mentionedUser User       @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@index([mentionedUserId, createdAt])
  @@index([forumPostId])
  @@index([hubPostId])
}

model ForumView {
  id        String   @id @default(cuid())
  postId    String
  viewerId  String?
  createdAt DateTime @default(now())

  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  // ✅ Named relation + back relation on User
  viewer User?     @relation("ForumView_viewer", fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([viewerId])
}

model ForumComment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())

  @@index([postId])
  @@index([postId, createdAt])
  @@index([userId])
}

model ForumReaction {
  id     String @id @default(cuid())
  postId String
  userId String
  type   String

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model ForumSave {
  id     String @id @default(cuid())
  postId String
  userId String

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model ForumRepost {
  id     String @id @default(cuid())
  postId String
  userId String

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model OpportunityAction {
  id            String @id @default(cuid())
  userId        String
  opportunityId String

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  state       ActionState @default(NONE)
  investedAmt Float?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, opportunityId])
  @@index([userId, state])
  @@index([opportunityId])
}

model Message {
  id             String    @id @default(cuid())
  fromUserId     String
  toUserId       String
  conversationId String?
  body           String
  opportunityId  String?
  readAt         DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  fromUser     User          @relation("MessageFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User          @relation("MessageToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([opportunityId])
  @@index([conversationId, createdAt])
}

model Conversation {
  id            String    @id @default(cuid())
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TagFollow {
  id        String    @id @default(cuid())
  userId    String
  tag       String
  source    TagSource
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag, source])
  @@index([userId])
}

model MoneyManagement {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  incomeMonthly       Float?
  incomeYearly        Float?
  taxRate             Float?
  locationCountry     String?
  locationRegion      String?
  investmentsValue    Float?
  investmentsCashflow Float?
  debts               Float?
  spendingDaily       Float?
  liabilities         Float?
  spendingWeekly      Float?
  spendingMonthly     Float?
  savingsCurrent      Float?
  dependents          Int?
  goalSavings         Float?
  goalInvestments     Float?
  goalNetWorth        Float?
  hideSensitive       Boolean         @default(false)
  snapshots           MoneySnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MoneySnapshot {
  id                String   @id @default(cuid())
  moneyManagementId String
  grossMonthly      Float
  netMonthly        Float
  spendingTotal     Float
  netCashflow       Float
  savingsCurrent    Float
  createdAt         DateTime @default(now())

  moneyManagement MoneyManagement @relation(fields: [moneyManagementId], references: [id], onDelete: Cascade)

  @@index([moneyManagementId, createdAt])
}

model JournalEntry {
  id           String   @id @default(cuid())
  ownerId      String
  title        String?
  body         String
  entryDate    DateTime
  imageUrls    String[] @default([])
  chartData    Json?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner         User                  @relation("JournalOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators JournalCollaborator[]
  invites       JournalInvite[]

  @@index([ownerId, entryDate])
}

model JournalCollaborator {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  role      String?
  createdAt DateTime @default(now())

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([userId])
}

model JournalInvite {
  id         String              @id @default(cuid())
  entryId    String
  fromUserId String
  toUserId   String
  status     FollowRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  fromUser User         @relation("JournalInviteSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User         @relation("JournalInviteReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([entryId])
}

model Report {
  id               String           @id @default(cuid())
  reporterId       String
  targetType       ReportTargetType
  targetId         String
  reason           String
  details          String?
  isScam           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?
  resolutionNote   String?
  reviewedByUserId String?

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([resolvedAt, createdAt])
}

model VerificationRequest {
  id               String              @id @default(cuid())
  userId           String
  docType          VerificationDocType
  fileUrls         String[]            @default([])
  status           VerificationStatus  @default(PENDING)
  note             String?
  reviewNote       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user       User  @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model AppSession {
  id              String   @id @default(cuid())
  userId          String
  startedAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  durationSeconds Int      @default(0)
  platform        String   @default("web")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([startedAt])
}

model SupportTicket {
  id         String              @id @default(cuid())
  userId     String?
  email      String
  subject    String
  message    String
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Advertisement {
  id              String      @id @default(cuid())
  title           String
  body            String?
  imageUrl        String?
  linkUrl         String?
  placement       AdPlacement @default(FEED)
  active          Boolean     @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  impressions     Int         @default(0)
  clicks          Int         @default(0)
  createdByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  createdBy User? @relation("AdCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([active, placement])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

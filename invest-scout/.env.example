# Core
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invest_scout
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Redis (required for rate limiting, caching, queues)
REDIS_URL=redis://localhost:6379

# Cache TTLs (seconds)
FEED_CACHE_TTL_SECONDS=30
PROFILE_CACHE_TTL_SECONDS=30

# Uploads
STORAGE_DRIVER=local
MAX_IMAGE_SIZE_BYTES=5242880
MAX_CV_SIZE_BYTES=10485760
MAX_POST_BODY_LENGTH=5000
MAX_COMMENT_LENGTH=1000

# S3 / Object storage (required for production stateless uploads)
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# News ingestion
NEWS_SOURCES_PATH=config/news-sources.json
NEWS_INTEREST_KEYWORDS_PATH=config/interest-keywords.json
NEWS_DEFAULT_COUNTRIES=GLOBAL,US,GB
NEWS_MAX_SOURCES=30

# Admin worker
ADMIN_INGEST_TOKEN=
APP_URL=http://localhost:3000

# Email
EMAIL_FROM=noreply@invescout.com

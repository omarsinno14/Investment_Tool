generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RiskTolerance {
  EXTREMELY_LOW
  LOW
  MEDIUM
  MEDIUM_HIGH
  HIGH
  EXTREMELY_HIGH
}

enum InterestType {
  SECTOR
  INDUSTRY
  COUNTRY
  CUSTOM
}

enum ActionState {
  NONE
  SAVED
  VERY_INTERESTED
  INVESTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile             Profile?
  interests           Interest[]
  actions             OpportunityAction[]
  moneyManagement     MoneyManagement?
  postedOpportunities Opportunity[]
  messagesSent        Message[]           @relation("MessageFromUser")
  messagesReceived    Message[]           @relation("MessageToUser")
  forumPosts          ForumPost[]
  forumComments       ForumComment[]
  forumReactions      ForumReaction[]
  forumSaves          ForumSave[]
  forumReposts        ForumRepost[]

  @@index([email])
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                        String?
  username                    String?       @unique
  phone                       String?       @unique
  imageUrl                    String?
  cvUrl                       String?
  bio                         String?
  occupation                  String?
  currency                    String?
  age                         Int?
  familySituation             String?
  netWorth                    Float?
  riskTolerance               RiskTolerance @default(MEDIUM)
  investAmount                Float?
  layoutPreference            String?
  emailVerified               Boolean       @default(false)
  phoneVerified               Boolean       @default(false)
  hideAgeFromNonFollowers     Boolean       @default(false)
  hideContactFromNonFollowers Boolean       @default(false)
  hidePhotoFromNonFollowers   Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Interest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      InterestType
  value     String
  parent    String?
  createdAt DateTime     @default(now())

  @@unique([userId, type, value])
  @@index([userId])
}

model Opportunity {
  id              String    @id @default(cuid())
  title           String
  url             String?   @unique
  source          String?
  summary         String?
  imageUrl        String?
  imageUrls       String[]  @default([])
  details         String?
  askAmount       Float?
  benefits        String?
  contactEmail    String?
  contactPhone    String?
  contactUsername String?
  locationName    String?
  locationMapUrl  String?
  tags            String[]  @default([])
  messages        Message[]
  createdByUserId String?
  createdByUser   User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  fetchedAt       DateTime  @default(now())
  archivedAt      DateTime?

  categories String[] @default([])
  keywords   String[] @default([])

  actions OpportunityAction[]

  @@index([fetchedAt])
}

model ForumPost {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String
  imageUrl   String?
  tags       String[]  @default([])
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  comments  ForumComment[]
  reactions ForumReaction[]
  saves     ForumSave[]
  reposts   ForumRepost[]

  @@index([userId])
}

model ForumComment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())

  @@index([postId])
  @@index([userId])
}

model ForumReaction {
  id     String @id @default(cuid())
  postId String
  userId String
  type   String

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model ForumSave {
  id     String @id @default(cuid())
  postId String
  userId String

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model ForumRepost {
  id     String @id @default(cuid())
  postId String
  userId String

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model OpportunityAction {
  id            String @id @default(cuid())
  userId        String
  opportunityId String

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  state       ActionState @default(NONE)
  investedAmt Float?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, opportunityId])
  @@index([userId, state])
  @@index([opportunityId])
}

model Message {
  id            String   @id @default(cuid())
  fromUserId    String
  toUserId      String
  body          String
  opportunityId String?
  createdAt     DateTime @default(now())

  fromUser    User         @relation("MessageFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User         @relation("MessageToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([opportunityId])
}

model MoneyManagement {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  incomeMonthly       Float?
  incomeYearly        Float?
  taxRate             Float?
  locationCountry     String?
  locationRegion      String?
  investmentsValue    Float?
  investmentsCashflow Float?
  debts               Float?
  spendingDaily       Float?
  liabilities         Float?
  spendingWeekly      Float?
  spendingMonthly     Float?
  savingsCurrent      Float?
  dependents          Int?
  goalSavings         Float?
  goalInvestments     Float?
  goalNetWorth        Float?
  hideSensitive       Boolean         @default(false)
  snapshots           MoneySnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MoneySnapshot {
  id                String   @id @default(cuid())
  moneyManagementId String
  grossMonthly      Float
  netMonthly        Float
  spendingTotal     Float
  netCashflow       Float
  savingsCurrent    Float
  createdAt         DateTime @default(now())

  moneyManagement MoneyManagement @relation(fields: [moneyManagementId], references: [id], onDelete: Cascade)

  @@index([moneyManagementId, createdAt])
}

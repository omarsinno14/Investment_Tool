# ---------------------------------------------------------------------------
# Vertica environment variables
# Copy to .env and fill in real values. Never commit your real .env file.
# ---------------------------------------------------------------------------

# --- Database (required) ---
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://user:password@host:5432/vertica

# --- API server (required) ---
# Secret used to sign session cookies. Use a long, random string.
SESSION_SECRET=replace-with-a-long-random-string
# Port the API server listens on.
PORT=8080

# --- Optional ---
# Runtime environment: development | production
NODE_ENV=development
# Pino log level: info | debug | warn | error
LOG_LEVEL=info
# Comma-separated list of additional allowed CORS origins.
ALLOWED_ORIGINS=
# Version string surfaced at /api/version and /api/health.
APP_VERSION=1.0.0
